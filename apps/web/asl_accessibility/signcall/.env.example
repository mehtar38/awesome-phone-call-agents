# Copy this file to .env and fill it in. .env is git-ignored -- never commit it.
# Variables already set in your shell win over this file.

# --- Credentials -------------------------------------------------------------
CALLE_API_KEY=
# Optional, but without it no clinic can ever be found: there's no synthetic
# fallback. A missing token, an Apify failure, or zero places surviving the
# filters all come back as an empty clinic list, and the workflow raises a
# clear "no clinic could be found" error rather than fabricating one.
APIFY_API_TOKEN=
# No credential needed for interpreter search either. An Illinois clinic
# queries IDHHC's public registry live (workflow/interpreter_lookup.py).
# Everywhere else covered has no real interpreter source yet, so a freelance
# search there also comes back honestly empty -- same "no synthetic
# fallback" principle as clinics above (the user-arranged and family-member
# paths don't need any interpreter source at all, so they're unaffected).
# Set this to 1 to skip the live IL lookup and fail fast instead -- the test
# harness does this automatically; you'd only set it by hand for offline dev.
# SIGNCALL_DISABLE_IL_LOOKUP=0

# --- Call mode ---------------------------------------------------------------
# 1 = every call is scripted: no real calls, no CALL-E credits spent.
# 0 = real calls.
CALLE_MOCK_MODE=1
# The server refuses to start with CALLE_MOCK_MODE=0 unless this is 1, so a
# real-call server is never started by accident.
SIGNCALL_API_ALLOW_REAL_CALLS=0
# Scripted answers for the mock mode above; ignored when CALLE_MOCK_MODE=0.
SIGNCALL_API_DEMO_MOCKS=1

# --- Talking to the frontend --------------------------------------------------
# Where run events (approval requests, outcomes) are POSTed.
SIGNCALL_NOTIFY_URL=http://localhost:8000/notifications
# Seconds to wait for the user's approval before treating no answer as "no".
# SIGNCALL_CONFIRM_TIMEOUT_SECONDS=900
